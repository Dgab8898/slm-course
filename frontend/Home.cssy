.page {
  padding: 20px;
  font-family: Arial;
}

.hero {
  text-align: center;
  margin-bottom: 30px;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
}

.card {
  width: 270px;
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  transition: all 0.3s ease;
  position: relative;
}

.card:hover {
  transform: translateY(-8px);
  box-shadow: 0 15px 35px rgba(0,0,0,0.15);
}

.image {
  width: 100%;
  height: 160px;
  object-fit: cover;
}

.content {
  padding: 10px;
}

.desc {
  font-size: 13px;
  color: #666;
}

.location {
  font-size: 12px;
}

.rating {
  font-size: 14px;
}

.price {
  margin-top: 5px;
}

.button {
  width: 100%;
  padding: 10px;
  background: #007bff;
  color: white;
  border: none;
  margin-top: 10px;
  cursor: pointer;
  border-radius: 6px;
}

.button:hover {
  background: #0056b3;
}
